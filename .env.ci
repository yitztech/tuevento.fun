# Entorno de pruebas de integración y CI (compose.ci.yml sobre compose.prod.yml).
# Valores ficticios, seguros y autocontenidos (sin secretos reales).
IMAGE_PREFIX=local/tueventofun
IMAGE_TAG=ci
RELEASE_SHA=ci
WEB_PORT=5187
API_PORT=3087
DB_PORT=5487
SITE_URL_ES=https://tueventofun.orb.local
SITE_URL_EN=https://en.tueventofun.orb.local
ALLOWED_ORIGINS=http://localhost:5187,http://127.0.0.1:5187,https://tueventofun.orb.local,http://tueventofun.orb.local,https://en.tueventofun.orb.local,http://en.tueventofun.orb.local,http://en.tueventofun.orb.local:5187,https://gateway.tueventofun.orb.local,http://gateway.tueventofun.orb.local
TRUSTED_PROXY_CIDR=127.0.0.1/32
POSTGRES_PASSWORD=ci-postgres
API_DB_PASSWORD=ci-api
RELEASE_PUBLISH_TOKEN=ci-token-000000000000000000000000000000
