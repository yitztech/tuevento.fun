# bash scripts/setup.sh creates a random local DB secret; no default user account.
DB_PASSWORD=REPLACE_WITH_A_RANDOM_SECRET
WEB_PORT=5187
API_PORT=3087
DB_PORT=5487
ALLOWED_ORIGINS=http://localhost:5187,http://127.0.0.1:5187
GOOGLE_CLIENT_ID=
COOKIE_SECURE=false
DEMO_ENABLED=true

# Release catalog: generate a private token (32+ chars), store the same value in GitHub secrets.
RELEASE_PUBLISH_TOKEN=
RELEASE_DOWNLOAD_HOSTS=github.com,apps.apple.com,testflight.apple.com,play.google.com
# Mobile build only; actual public HTTPS origin is required for distribution.
VITE_PUBLIC_ORIGIN=
VITE_APP_VERSION=1.0.0
MOBILE_APP_ID=com.tueventofun.app
# Production workflow / compose
PUBLIC_ORIGIN=
IMAGE_BASE=
IMAGE_TAG=
