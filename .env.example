# DESARROLLO local (compose.yml). bash scripts/setup.sh crea .env desde aquí con una
# contraseña aleatoria de PostgreSQL; no hay usuario predeterminado.
# En producción estas variables las pasa la plataforma a compose.prod.yml (ver README).
POSTGRES_PASSWORD=REPLACE_WITH_A_RANDOM_SECRET
API_DB_PASSWORD=REPLACE_WITH_A_RANDOM_SECRET_API
WEB_PORT=5187
API_PORT=3087
DB_PORT=5487

# Un idioma por dominio, como en producción: tuevento.localhost (es) y yourevent.localhost (en).
# El navegador resuelve *.localhost solo; localhost:5187 también sirve el español (acceso con Google).
SITE_URL_ES=http://tuevento.localhost:5187
SITE_URL_EN=http://yourevent.localhost:5187
# Todo origen desde el que se navegue; sin él, todo POST desde esa URL da 403.
ALLOWED_ORIGINS=http://localhost:5187,http://127.0.0.1:5187,http://tuevento.localhost:5187,http://yourevent.localhost:5187
# En local no hay proxy delante del gateway
TRUSTED_PROXY_CIDR=127.0.0.1/32
GOOGLE_CLIENT_ID=
COOKIE_SECURE=false
DEMO_ENABLED=true
# Analítica con Umami (vacío = sin analítica)
UMAMI_SCRIPT_URL=
UMAMI_WEBSITE_ID=

# Catálogo de releases: token privado (32+ caracteres), el mismo que el secreto de GitHub.
RELEASE_PUBLISH_TOKEN=
RELEASE_DOWNLOAD_HOSTS=github.com,apps.apple.com,testflight.apple.com,play.google.com

# Correo transaccional (recuperar contraseña). Sin sufijo = español (tuevento.fun);
# _EN = inglés (yourevent.fun). En local, compose.yml usa Mailpit si se dejan vacías.
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
SMTP_USER_EN=
SMTP_PASSWORD_EN=
MAIL_FROM_EN=

# Newsletter: un Listmonk por idioma (news.<dominio>), suscripción pública con el UUID de la lista
LISTMONK_URL=
LISTMONK_LIST_UUID=
LISTMONK_URL_EN=
LISTMONK_LIST_UUID_EN=

# Búsqueda en el mapa. En local, el doble geocoder-fake; vacío = Nominatim (OpenStreetMap), como en producción.
# GEOCODER_URL=

# Solo builds móviles: origen HTTPS público al que se conecta la app.
VITE_PUBLIC_ORIGIN=
VITE_APP_VERSION=1.0.0
MOBILE_APP_ID=com.tueventofun.app
