{
  "name": "tueventofun",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build -w @tuevento/contracts && npm run build -w @tuevento/client && npm run build -w @tuevento/api && npm run build -w @tuevento/web",
    "dev": "npm run dev -w @tuevento/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "tsx --test packages/contracts/src/*.test.ts",
    "test:api": "node scripts/test-api.mjs",
    "test:browser": "node scripts/test-browser.cjs",
    "test:landing": "node scripts/test-landing.cjs",
    "test:platform": "node scripts/test-platform.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.18.6",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3",
    "uuid": "^11.1.1"
  },
  "overrides": {
    "xcode": {
      "uuid": "^11.1.1"
    }
  }
}
