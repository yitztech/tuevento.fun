{
  "name": "tueventofun",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "apps/*",
    "packages/*",
    "tests/*"
  ],
  "scripts": {
    "build": "npm run build -w @tuevento/contracts && npm run build -w @tuevento/client && npm run build -w @tuevento/api && npm run build -w @tuevento/web",
    "dev": "npm run dev -w @tuevento/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "node scripts/check-versions.mjs && tsx --test packages/contracts/src/*.test.ts",
    "test:api": "node scripts/test-api.mjs",
    "test:browser": "node scripts/test-browser.cjs",
    "test:landing": "node scripts/test-landing.cjs",
    "test:password": "node scripts/test-password-reset.cjs",
    "test:platform": "node scripts/test-platform.mjs",
    "check:versions": "node scripts/check-versions.mjs",
    "e2e": "npm test -w @tuevento/e2e",
    "e2e:headed": "npm run test:headed -w @tuevento/e2e",
    "e2e:ui": "npm run test:ui -w @tuevento/e2e",
    "e2e:summary": "npm run summary -w @tuevento/e2e"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2",
    "uuid": "^14.0.3"
  },
  "overrides": {
    "xcode": {
      "uuid": "^14.0.3"
    }
  }
}
