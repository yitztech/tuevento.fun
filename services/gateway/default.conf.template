# Gateway detrás del proxy de la plataforma (Traefik en Coolify). Traefik termina TLS;
# este nginx escucha en HTTP (80) y reparte:
#   /api/ y /.well-known/*  → api:3087
#   todo lo demás           → web:8080 (la SPA, con su idioma por Host)
# Las variables ${...} las sustituye el entrypoint de nginx al arrancar (solo
# TRUSTED_PROXY_CIDR, ver NGINX_ENVSUBST_FILTER).
server_tokens off;

# Docker cambia la IP de un contenedor cada vez que lo recrea. Con `resolve` nginx
# vuelve a consultar el DNS interno de Docker y sigue la IP nueva sin reiniciarse.
resolver 127.0.0.11 valid=10s ipv6=off;
upstream api_upstream { zone api_upstream 64k; server api:3087 resolve; keepalive 16; }
upstream web_upstream { zone web_upstream 64k; server web:8080 resolve; keepalive 16; }
upstream admin_upstream { zone admin_upstream 64k; server admin:3088 resolve; keepalive 4; }

# ── IP real del cliente ─────────────────────────────────────────────
# Solo se confía en X-Forwarded-For si llega de la red donde está Traefik
# (TRUSTED_PROXY_CIDR). Sin esto todo el mundo parecería tener la IP de Traefik.
set_real_ip_from ${TRUSTED_PROXY_CIDR};
real_ip_header X-Forwarded-For;
real_ip_recursive on;

# Protocolo original: Traefik ya terminó TLS, aquí $scheme siempre es "http"
map $http_x_forwarded_proto $forwarded_proto { default $scheme; https https; }
# Host original con su puerto; si el cliente no envía Host, el del servidor
map $http_host $forward_host { "" $host; default $http_host; }
# WebSocket (recarga en caliente de Vite en desarrollo); keepalive en lo demás
map $http_upgrade $connection_upgrade { default upgrade; '' ''; }

# ── Caché (preparada, sin activar) ──────────────────────────────────
# Para cachear el frontend en el gateway: descomentar la zona y las líneas
# `proxy_cache` de /assets/. Los recursos con hash son inmutables; el HTML varía por
# Host (idioma), así que si algún día se cachea, la clave debe incluir $host.
# proxy_cache_path /var/cache/nginx/web levels=1:2 keys_zone=web_cache:2m max_size=200m inactive=7d use_temp_path=off;

# Panel de administración: solo su subdominio llega a `admin`; el resto de hosts sigue igual.
server {
    listen 80;
    server_name ${ADMIN_HOST};
    client_max_body_size 4k;
    # El panel no pasa por `web`, que es quien pone las cabeceras de las páginas: HSTS aquí (SEG-04)
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    location / {
        include /etc/nginx/snippets/proxy-headers.conf;
        proxy_pass http://admin_upstream;
    }
}

# Servidor por defecto: cualquier Host que no sea el del panel (nginx usaría el primero del archivo)
server {
    listen 80 default_server;
    server_name _;
    # 1 MB como la API (AGENTS.md §23); las subidas de imágenes, 3 MB (sus locations)
    client_max_body_size 1m;

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 'ok';
    }

    # Subidas de imágenes (avatar, fotos de la postal y del proveedor): el mismo límite que la API en esas rutas
    location = /api/profile/avatar {
        add_header X-Robots-Tag "noindex" always;
        client_max_body_size 3m;
        include /etc/nginx/snippets/proxy-headers.conf;
        proxy_pass http://api_upstream;
    }
    location = /api/provider/images {
        add_header X-Robots-Tag "noindex" always;
        client_max_body_size 3m;
        include /etc/nginx/snippets/proxy-headers.conf;
        proxy_pass http://api_upstream;
    }
    location ~ ^/api/events/[^/]+/postcard/images$ {
        add_header X-Robots-Tag "noindex" always;
        client_max_body_size 3m;
        include /etc/nginx/snippets/proxy-headers.conf;
        proxy_pass http://api_upstream;
    }

    # Solo para `web` por la red interna (estado de las páginas de proveedores)
    location /api/internal/ {
        add_header X-Robots-Tag "noindex" always;
        return 404;
    }

    # Sitemap de las páginas de proveedores del dominio (lo genera la API)
    location = /sitemap-providers.xml {
        include /etc/nginx/snippets/proxy-headers.conf;
        proxy_pass http://api_upstream/api/public/sitemap/providers.xml;
    }

    # API y avisos en tiempo real (SSE): sin buffer y con conexiones largas
    location /api/ {
        add_header X-Robots-Tag "noindex" always;
        include /etc/nginx/snippets/proxy-headers.conf;
        proxy_buffering off;
        proxy_read_timeout 1h;
        proxy_pass http://api_upstream;
    }

    # Verificación de App Links (Android e iOS), servida por la API en cualquier dominio
    location = /.well-known/assetlinks.json {
        include /etc/nginx/snippets/proxy-headers.conf;
        proxy_pass http://api_upstream/api/.well-known/assetlinks.json;
    }
    location = /.well-known/apple-app-site-association {
        include /etc/nginx/snippets/proxy-headers.conf;
        proxy_pass http://api_upstream/api/.well-known/apple-app-site-association;
    }

    # Recursos con hash en el nombre (inmutables): candidatos a caché en el gateway
    location /assets/ {
        include /etc/nginx/snippets/proxy-headers.conf;
        # proxy_cache web_cache;
        # proxy_cache_valid 200 7d;
        # add_header X-Cache-Status $upstream_cache_status always;
        proxy_pass http://web_upstream;
    }

    # Frontend: el Host original llega a `web`, que decide el idioma
    location / {
        include /etc/nginx/snippets/proxy-headers.conf;
        proxy_pass http://web_upstream;
    }
}
