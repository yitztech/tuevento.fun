# SOLO PARA PRUEBAS. Nunca se despliega en un VPS ni en producción.
# HTTPS local para las apps móviles (emulador Android / simulador iOS), que exigen un
# origen HTTPS. Caddy genera su propia CA local (`tls internal`) y firma con ella el
# certificado de `localhost`; la CA se exporta con scripts/mobile-test-ca.sh.
{
	local_certs
	skip_install_trust
	auto_https disable_redirects
}

https://localhost:8443 {
	tls internal
	reverse_proxy gateway:80
}
