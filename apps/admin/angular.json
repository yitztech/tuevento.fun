{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": { "analytics": false },
  "newProjectRoot": "",
  "projects": {
    "admin": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src/web",
      "prefix": "admin",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "dist",
            "index": "src/web/index.html",
            "browser": "src/web/main.ts",
            "tsConfig": "tsconfig.app.json",
            "styles": ["src/web/styles.css"],
            "optimization": {
              "scripts": true,
              "styles": { "minify": true, "inlineCritical": false },
              "fonts": false
            },
            "sourceMap": false,
            "outputHashing": "all",
            "budgets": [{ "type": "initial", "maximumWarning": "300kB", "maximumError": "500kB" }]
          }
        }
      }
    }
  }
}
